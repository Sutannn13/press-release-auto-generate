GEMINI_API_KEY=

# Password bersama untuk pegawai. Gunakan password panjang dan unik.
APP_ACCESS_PASSWORD=

# Minimal 32 karakter acak. Contoh pembuatan: openssl rand -base64 48
SESSION_SECRET=

# Redis REST (Upstash) untuk rate-limit lintas instance Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
