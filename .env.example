GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_BACKUP_1=
GEMINI_API_KEY_BACKUP_2=
GEMINI_MODEL_PRIMARY=gemini-3.6-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite

# Password bersama untuk pegawai. Untuk URL publik, gunakan minimal 16 karakter yang unik.
APP_ACCESS_PASSWORD=

# Minimal 32 karakter acak. Contoh pembuatan: openssl rand -base64 48
SESSION_SECRET=

# Redis REST (Upstash) untuk rate-limit lintas instance hosting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
