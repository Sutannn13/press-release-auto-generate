{
  "name": "kemenag-pressrelease-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:docx": "tsx scripts/generate-dummy-docx.ts && python scripts/validate-docx.py",
    "test:gemini": "tsx scripts/test-gemini.ts",
    "test:gemini:live": "node --env-file-if-exists=.env.local --import tsx scripts/test-gemini-live.ts",
    "test:api": "node --env-file-if-exists=.env.local --import tsx scripts/test-api-routes.ts && python scripts/validate-docx.py artifacts/phase-4/api-export.docx 1",
    "test:browser": "npm run build && playwright test",
    "test:golden": "npm run test:docx && python scripts/audit-golden-geber.py",
    "test:v2": "npm run test:gemini && npm run test:docx && npm run test:api"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "^16.3.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.17.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
